<!DOCTYPE html>
<html lang="fi">
<head>
    <meta charset="UTF-8">
    <title>Hotellivaraus</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; }
        .laatikko { max-width: 400px; padding: 20px; border: 1px solid #ccc; border-radius: 5px; }
        input, select, button { width: 100%; padding: 8px; margin-top: 8px; margin-bottom: 15px; }
        button { background-color: #28a745; color: white; border: none; cursor: pointer; }
        .tulokset { margin-top: 15px; background: #f9f9f9; padding: 10px; }
    </style>
</head>
<body>
    <div class="laatikko">
        <h2>Etsi vapaita huoneita</h2>
        <label>Saapumispäivä:</label>
        <input type="date" value="2026-11-01">
        
        <label>Lähtöpäivä:</label>
        <input type="date" value="2026-11-03">
        
        <label>Huonetyyppi:</label>
        <select>
            <option>Kaikki huoneet</option>
            <option>1hh Standard</option>
            <option>2hh Superior</option>
        </select>
        
        <button>Hae vapaat huoneet</button>

        <div class="tulokset">
            <strong>Vapaat huoneet (API-haku):</strong>
            <ul>
                <li>Huone 101 - 1hh Standard (85e/yö)</li>
                <li>Huone 204 - 2hh Superior (120e/yö)</li>
            </ul>
        </div>
    </div>
</body>
</html>